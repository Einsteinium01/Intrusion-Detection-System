# .env.example
# =============
# Copy this file to .env and fill in your values.
# NEVER commit .env or any real API keys to version control.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your values
#   python backend/app.py

# ---------------------------------------------------------------------------
# AI Layer (Phase 1)
# ---------------------------------------------------------------------------

# Enable or disable the AI analysis endpoints entirely.
# Set to 'true' to activate /api/ai/analyze-alert and /api/ai/status.
AI_ENABLED=false

# LLM provider to use. Currently only 'groq' is supported.
# Future values: 'ollama', 'openai', 'anthropic'
LLM_PROVIDER=groq

# Your Groq API key.  Obtain from: https://console.groq.com/keys
# NEVER hardcode this value.  NEVER commit it to version control.
GROQ_API_KEY=your_groq_api_key_here

# Model to use via the Groq API.
# Default: openai/gpt-oss-120b
# Other options: llama-3.3-70b-versatile, mixtral-8x7b-32768
GROQ_MODEL=openai/gpt-oss-120b

# Reasoning effort for models that support it.
# Values: none | low | medium | high | default
GROQ_REASONING_EFFORT=medium

# HTTP timeout for Groq API calls (seconds).
GROQ_TIMEOUT_SECONDS=60.0
# ---------------------------------------------------------------------------
# RAG Layer (Phase 2)
# ---------------------------------------------------------------------------

# Enable or disable local RAG knowledge retrieval.
# RAG is enrichment only — it does NOT affect intrusion detection.
RAG_ENABLED=true

# Sentence-transformers embedding model for local embeddings (CPU-friendly).
# all-MiniLM-L6-v2 is 22 MB and fast on CPU.
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Number of documents to retrieve per alert query.
RAG_TOP_K=5

# Minimum cosine similarity score to include a result (0.0 = include all top-k).
RAG_MIN_SCORE=0.0

# Chunk size (words) and overlap for document chunking.
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64

# Number of automatic retries on transient network errors.
GROQ_MAX_RETRIES=2
